import funkin.play.PlayState;
import funkin.Conductor;
import flixel.FlxG;

import funkin.play.event.ScriptedSongEvent;

class SimpleHUDShakeEvent extends ScriptedSongEvent {

  function new() {
    super("simpleHUDShake");
  }

  public var eventTitle:String = "Simple HUD Shake";

  public var DEFAULT_DURATION:Float = 1.0;
  public var DEFAULT_INTENSITY:Float = 0.01;

  override function handleEvent(data):Void {
    if (PlayState.instance == null) return;
    if (PlayState.instance.currentStage == null) return;
    if (PlayState.instance.isMinimalMode) return;

    var duration:Float = data.getFloat("duration") != null ? data.getFloat("duration") : DEFAULT_DURATION;

    var durSeconds:Float = Conductor.instance.stepLengthMs * duration / 1000;

    // Sempre aplica no HUD
    PlayState.instance.camHUD?.shake(DEFAULT_INTENSITY, durSeconds, 0x11);
  }

  public override function getTitle() {
    return eventTitle;
  }

  override function getEventSchema() {
    return [
      {
        name: "duration",
        title: "Duration",
        type: "float",
        defaultValue: 1.0,
        step: 0.5,
        min: 0
      }
    ];
  }
}
